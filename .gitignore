# Xcode build products (DerivedData path used by CLI builds)
build/

# Command Code session files
.commandcode/
.build/
.hermes/

# Xcode user state (scheme selection, breakpoints) — machine-local
.swiftpm/xcode/xcuserdata/
Git.xcodeproj/xcuserdata/
CLAUDE.md
/.claude

# Finder metadata
.DS_Store

# Xcode and SwiftPM per-machine state
xcuserdata/
.swiftpm/

# macOS
# Finder folder icon: a file named Icon plus a carriage return
Icon[
]

# Build
DerivedData/
*.xcuserstate

# Secrets
.env

# Agents (local agent instructions, settings and boards)
AGENTS.md
.claude/
.codex/
KANBAN*.md

# Manual tests
tmp

# Package pins: the .xcodeproj's Package.resolved is committed and a release builds from it alone (security audit
# H2: release.sh's check). The -Local workspace and SwiftPM's own pins follow the checkouts next to this one
# (V57_LOCAL=1) or GitHub's main, so they stay unpinned
/Git.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!/Git.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
/Git-Local.xcworkspace/xcshareddata/
/Package.resolved
