# How Tools/release/release.sh ships this app (see release.env.example).
APP_NAME=Git
SCHEME=Git
PROJECT=Git.xcodeproj
WORKSPACE=
PLATFORM=macos
TEAM_ID=AUCR797TMH
VERSION=0.1.0

TEST_SCHEME=
TEST_DESTINATION=
SCREENSHOT_TEST=
SCREENSHOT_LOCALES=en-US
SCREENSHOT_DESTINATION=

DIRECT_DOWNLOAD='zip dmg'
DIRECT_ARCHS=arm64
DIRECT_SETTINGS=
NOTARY_PROFILE=notary

GITHUB_REPO=v57/Git
GITHUB_DRAFT=yes

APP_STORE=no

# Windows and Linux (built on a VM), Android, and their stores.
WINDOWS_ARCHS='arm64 x64'
WINDOWS_PRODUCT=GitWinUI
LINUX_PRODUCT=Git
LINUX_CATEGORIES=Development;RevisionControl;

# Package pins: the committed Package.resolved pins the v57 libraries' main branches at pushed revisions (they have
# no tags yet): release.sh takes them at those revisions and archives from that file alone.
RELEASE_PINS=revision
