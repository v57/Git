<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The v57 vault (../Vault): the projects and hosts the v57 apps share, in the app group container, sealed
	     with keys from the shared keychain group, where this device's SSH key (Secure Enclave) is too, and iCloud
	     sync through CloudKit, so the devices and projects stay current without another v57 app on the device. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.v57</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)dev.v57.shared</string>
		<string>$(AppIdentifierPrefix)dev.v57.records</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.dev.v57</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-environment</key>
	<string>Production</string>
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
