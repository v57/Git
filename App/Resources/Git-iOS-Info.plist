<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- What Xcode can't generate from a build setting; the rest of the iOS app's Info.plist is generated.
	     Animations and scrolling at up to 120 fps on an iPhone with ProMotion; without it they stop at 60. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
</dict>
</plist>
